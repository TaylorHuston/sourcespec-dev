{
  "name": "example-todo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run catalog:check && npm run tests-catalog:check && npm run data-model:check && npm run requirements:check && tsc --noEmit && vite build",
    "test": "npm run catalog:check && npm run tests-catalog:check && npm run data-model:check && npm run requirements:check && vitest run",
    "catalog:check": "node ../../cli/dist/sourcespec.js sspc-functions check --app \"$PWD\"",
    "requirements:check": "node ../../cli/dist/sourcespec.js sspc-requirements check --app \"$PWD\"",
    "tests-catalog:check": "node ../../cli/dist/sourcespec.js sspc-tests check --app \"$PWD\"",
    "catalog:refresh": "node ../../cli/dist/sourcespec.js sspc-functions write --app \"$PWD\"",
    "tests-catalog:refresh": "node ../../cli/dist/sourcespec.js sspc-tests write --app \"$PWD\"",
    "data-model:probe": "node scripts/data-model-catalog.mjs probe",
    "data-model:refresh": "node scripts/data-model-catalog.mjs write",
    "data-model:check": "node scripts/data-model-catalog.mjs check",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.6",
    "yaml": "2.9.1"
  }
}
