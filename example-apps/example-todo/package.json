{
  "name": "example-todo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run catalog:check && npm run requirements:check && tsc --noEmit && vite build",
    "test": "npm run catalog:check && npm run requirements:check && node --test ../../tools/function-catalog.test.mjs ../../tools/requirements-check.test.mjs && vitest run",
    "catalog:check": "node ../../tools/function-catalog.mjs --check",
    "requirements:check": "node ../../tools/requirements-check.mjs",
    "catalog:refresh": "node ../../tools/function-catalog.mjs --write",
    "tests-catalog:refresh": "pnpm --dir ../../skills/sspc-tests-catalog exec tsx scripts/tests-catalog.ts --app \"$PWD\" --write",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.6",
    "yaml": "2.9.1"
  }
}
