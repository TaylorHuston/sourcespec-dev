{
  "name": "@sourcespec/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": { "node": ">=24" },
  "bin": { "sourcespec": "./dist/sourcespec.js" },
  "files": ["dist/", "assets/"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schemas.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && tsx --test test/*.test.ts test/catalog-integration.test.mjs && node --test test/install.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "typescript": "~6.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15"
  }
}
